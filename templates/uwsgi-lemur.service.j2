[Unit]
Description=Lemur uwsgi service

[Service]
ExecStart=/usr/bin/uwsgi_python3 --ini /var/www/btp-lemur/uwsgi.ini
RuntimeDirectory=uwsgi
User={{ lemur_service_user }}
Group={{ lemur_service_group }}
Restart=always
KillSignal=SIGQUIT
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
